{
  "name": "myfamily",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite dev",
    "mvp:local": "node scripts/start-local.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:av": "node scripts/test-antivirus.mjs",
    "test:backup": "node --test scripts/backup.test.mjs",
    "test:backup-cycle": "node --test scripts/backup-cycle.test.mjs",
    "test:recovery": "node scripts/test-supabase-recovery.mjs",
    "test:operations:restart": "node scripts/test-operational-restart.mjs",
    "test:operations:load": "node scripts/test-operational-load.mjs",
    "check:vps": "node scripts/check-vps-config.mjs",
    "test:vps-config": "node --test scripts/check-vps-config.test.mjs",
    "test:deploy": "node --test scripts/deploy.test.mjs scripts/bootstrap-admin.test.mjs scripts/delete-account.test.mjs",
    "test:db": "supabase test db",
    "test:e2e": "playwright test --pass-with-no-tests",
    "verify": "pnpm check && pnpm lint && pnpm test:unit && pnpm test:backup && pnpm build",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "start": "node build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.39.1",
    "@inlang/paraglide-js": "^2.29.3",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-svelte-csf": "^5.1.6",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/sveltekit": "^10.6.5",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@sveltejs/vite-plugin-svelte-inspector": "^5.0.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^20",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-svelte": "^3.13.0",
    "globals": "^16.5.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "storybook": "^10.6.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.3.7",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.2",
    "clsx": "^2.1.1",
    "daisyui": "^5.5.5",
    "tailwind-merge": "^3.4.0"
  },
  "packageManager": "pnpm@10.30.3"
}

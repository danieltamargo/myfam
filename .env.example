# Supabase Configuration
# Notes:
# - VITE_ prefix makes these available in client-side code
# - Get URL and publishable key from Supabase → Dashboard → Project Settings → API (Data API and API Keys)
# - The publishable key is safe to expose in client-side code (protected by RLS)

VITE_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PROJECT_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

VITE_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...


# Google OAuth (for Supabase Auth in local dev)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=...
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=...

# GitHub OAuth (for Supabase Auth in local dev)
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=...
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=...

# Node deployment origin; must match the public application URL.
ORIGIN=http://localhost:3000

# UUIDs of personally designated global administrators, separated by commas.
# Never use editable user_metadata to assign this role. Administration requires MFA.
SUPER_ADMIN_USER_IDS=

# Uploads fail closed when the antivirus cannot be reached.
# Empty uses localhost for pnpm dev and the clamav service in Docker Compose.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Calendar connections are separate from Supabase social login.
# Leave credentials empty to keep the corresponding provider unavailable.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_ORIGIN=http://localhost:5173
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_ORIGIN=http://localhost:5173

# JSON keyring: key identifiers map to random 32-byte keys encoded in base64.
# Generate private values using docs/GOOGLE_CALENDAR_SETUP.md; never commit them.
CALENDAR_TOKEN_KEYS=
CALENDAR_TOKEN_ACTIVE_KEY=
